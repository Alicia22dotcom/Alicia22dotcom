<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chalala Kids Library</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header>
    <h1>📚 Chalala Kids Library</h1>
    <nav>
      <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#books">Books</a></li>
        <li><a href="#events">Events</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <section id="home" class="section">
    <h2>Welcome to Chalala Kids Library</h2>
    <p>Where reading becomes fun! Explore exciting stories, fun activities, and learning resources for kids in our community.</p>
    <img src="images/kids-reading.jpg" alt="Kids reading books" class="hero-img">
  </section>

  <section id="books" class="section">
    <h2>Our Books</h2>
    <li><a href="https://freekidsbooks.org/">Free Kids Books</a></li>
<li><a href="https://www.freechildrenstories.com/">Free Children Stories</a></li>
    <div id="book-list" class="grid"></div>
  </section>

  <section id="events" class="section">
    <h2>Upcoming Events</h2>
    <ul>
      <li>📖 Storytelling Saturday - Every weekend at 10 AM</li>
      <li>🎨 Kids Art & Craft Day - First Sunday of every month</li>
      <li>🧩 Puzzle & Game Evening - Every Friday at 3 PM</li>
    </ul>
    <img src="images/story-time.jpg" alt="Storytelling session" class="event-img">
  </section>

  <section id="contact" class="section">
    <h2>Contact Us</h2>
    <p>📍 Location:Chalala Community Hall</p>
    <p>📞 Phone: +260-97-8862-635</p>
    <p>✉️ Email: aliciamalaika.am@gmail.com</p>
